- general:
    input_file: "slabA.4C.yaml"
    problem_type: "Thermo"
    spatial_approximation: "Polynomial"
    ndim: 2

- field:
    field: "thermo"
    time: 0
    step: 0
    num_nd: 187
    max_nodeid: 186
    num_ele: 160
    num_dof: 187
    num_dim: 2
    mesh_file: "out.mesh.thermo.s0"

- field:
    field: "thermo"
    time: 1
    step: 1
    num_nd: 187
    max_nodeid: 186
    num_ele: 160
    num_dof: 187
    num_dim: 2
    mesh_file: "out.mesh.thermo.s0"

- result:
    field: "thermo"
