    time: "10-09-2026 16-44-27"
    sha: "89519cfe76251fc668617c4ab1a70b94fd86ec52"
    version: "2026.2.0-dev"

- general:
    input_file: "slabA.4C.yaml"
    problem_type: "Thermo"
    spatial_approximation: "Polynomial"
    ndim: 2

- field:
    field: "thermo"
    time: 0
    step: 0
    num_nd: 33
    max_nodeid: 32
    num_ele: 20
    num_dof: 33
    num_dim: 2
    mesh_file: "out.mesh.thermo.s0"

- field:
    field: "thermo"
    time: 1
    step: 1
    num_nd: 33
    max_nodeid: 32
    num_ele: 20
    num_dof: 33
    num_dim: 2
    mesh_file: "out.mesh.thermo.s0"

- result:
    field: "thermo"
    time: 1
    step: 1
    result_file: "out.result.thermo.s1"
    temperature:
      type: "dof"
      columns: 1
      values: "/step1/temperature.values"
      ids: "/step1/temperature.ids"
    rate:
      type: "dof"
      columns: 1
      values: "/step1/rate.values"
      ids: "/step1/temperature.ids"

